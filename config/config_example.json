  "lada_cli_path": "lada-cli",
  "supported_extensions": [
    ".asf",
    ".flv",
    ".m4v",
    ".mp4",
    ".avi",
    ".mkv",
    ".mov",
    ".wmv",
    ".mpeg",
    ".mpg",
    ".ts",
